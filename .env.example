# Copy to .env and run: chmod 600 .env
# Key: https://connect.garmin.com/app/settings/personalApiToken
GARMIN_API_KEY=

# Optional
# GARMIN_TZ=Asia/Tbilisi        # your time zone (IANA); decides what "today" is. Default: system zone
# GARMIN_CACHE_DIR=off          # disable the disk cache, or set a path. Default: ~/.cache/garmin-mcp
# GARMIN_REGION=global          # "cn" for accounts on garmin.cn
# GARMIN_LOG_LEVEL=info         # debug | info | warn | error (logs go to stderr)
# GARMIN_ALLOW_SENSITIVE=0       # 1 = allow nutrition and menstrual-cycle endpoints in garmin_api_get
