# Copy to .env and run: chmod 600 .env
# Key: https://connect.garmin.com/app/settings/personalApiToken
GARMIN_API_KEY=

# Optional settings: remove the leading "# " to enable a line.

# Your IANA time zone; decides what "today" is. Default: the system zone.
# GARMIN_TZ=Europe/Berlin

# Cache directory, or "off". Default: the user cache dir (~/.cache/garmin-mcp on Linux).
# GARMIN_CACHE_DIR=off

# "cn" for accounts on garmin.cn. Default: global.
# GARMIN_REGION=global

# debug | info | warn | error (logs go to stderr). Default: info.
# GARMIN_LOG_LEVEL=info

# 1 = allow nutrition and menstrual-cycle endpoints in garmin_api_get. Default: off.
# GARMIN_ALLOW_SENSITIVE=0
